    characterSetSelectionMode: 8
    characterSequence: "\u65E5\u672C\u8A9E\r\n\r\n\r\nHUMR \u306F\u3001\u30E6\u30FC\u30B6\u30FC\u306E\u52D5\u304D\u3092
      VRChat \u306E\u30ED\u30B0\u30D5\u30A1\u30A4\u30EB\u306B\u8A18\u9332\u3057\u3001Unity
      \u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u5185\u3067 FBX \u3068\u3057\u3066\u30A8\u30AF\u30B9\u30DD\u30FC\u30C8\u3059\u308B\u30E2\u30FC\u30B7\u30E7\u30F3\u30AD\u30E3\u30D7\u30C1\u30E3\u30C4\u30FC\u30EB\u3067\u3059\u3002\u3053\u308C\u306F\u65B0\u3057\u3044\u30ED\u30B0\u5F62\u5F0F\u3092\u4F7F\u7528\u3059\u308B
      v2 \u3067\u3059\u3002\r\n\r\n<b><size=33>\u9332\u753B</size></b>\r\n\r\n<color=#eae915><b>\u5927\u5207</b></color>:
      HUMR \u3067\u9332\u753B\u3059\u308B\u306B\u306F\u3001VRChat \u306E<color=#2aaac1>\u30C7\u30D0\u30C3\u30B0</color>\u8A2D\u5B9A\u3067<color=#2aaac1>\u30ED\u30B0\u306E\u51FA\u529B</color>\u3092<color=#2aaac1>\u5143\u5168</color>\u306B\u8A2D\u5B9A\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\r\n\r\n\u30DF\u30E9\u30FC\u306B\u3042\u308B\u30DC\u30BF\u30F3\u3092\u4F7F\u3063\u3066\u9332\u753B\u3092\u958B\u59CB\u30FB\u505C\u6B62\u3057\u307E\u3059\u3002\u540C\u3058\u30D5\u30A1\u30A4\u30EB\u306B\u8907\u6570\u56DE\u9332\u753B\u3059\u308B\u3068\u3001\u305D\u308C\u305E\u308C
      Take \u3068\u3057\u3066\u5206\u5272\u3055\u308C\u307E\u3059\u3002\r\n\r\n\u9332\u753B\u6642\u3068\u30E2\u30FC\u30B7\u30E7\u30F3\u8AAD\u307F\u8FBC\u307F\u6642\u306B\u4F7F\u7528\u3059\u308B\u30A2\u30D0\u30BF\u30FC\u306E\u30DC\u30FC\u30F3\u306F\u3001\u5B8C\u5168\u306B\u4E00\u81F4\u3057\u3066\u3044\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\u73FE\u5728\u4F7F\u7528\u3057\u3066\u3044\u308B\u30A2\u30D0\u30BF\u30FC\u306E
      .fbx \u30D5\u30A1\u30A4\u30EB\u3092\u5165\u624B\u3067\u304D\u306A\u3044\u5834\u5408\u306F\u3001\u5DE6\u5074\u306E\u53F0\u5EA7\u306B\u3042\u308B
      HUMR-Chan \u3092\u4F7F\u7528\u3067\u304D\u307E\u3059\u3002HUMR-Chan \u306F\u30D1\u30C3\u30B1\u30FC\u30B8\u306B\u542B\u307E\u308C\u3066\u3044\u307E\u3059\u3002\u30A4\u30F3\u30DD\u30FC\u30C8\u5F8C\u3001Unity
      \u3067\u5225\u306E\u30A2\u30D0\u30BF\u30FC\u306B\u30A2\u30CB\u30E1\u30FC\u30B7\u30E7\u30F3\u3092\u30EA\u30BF\u30FC\u30B2\u30C3\u30C8\u3057\u305F\u308A\u3001Blender
      \u7528\u306E Rokoko \u30D7\u30E9\u30B0\u30A4\u30F3\u306A\u3069\u3092\u4F7F\u3063\u3066\u624B\u52D5\u3067\u30EA\u30BF\u30FC\u30B2\u30C3\u30C8\u3057\u305F\u308A\u3067\u304D\u307E\u3059\u3002\r\n\r\nVRChat
      \u306E\u30ED\u30B0\u306F\u7D04 1 \u9031\u9593\u5F8C\u306B\u524A\u9664\u3055\u308C\u308B\u305F\u3081\u3001\u4FDD\u5B58\u3057\u305F\u30C7\u30FC\u30BF\u3092\u8AAD\u307F\u8FBC\u3080\u304B\u3001\u30ED\u30B0\u30D5\u30A1\u30A4\u30EB\u3092\u5225\u306E\u5834\u6240\u306B\u30B3\u30D4\u30FC\u3057\u3066\u304F\u3060\u3055\u3044\u3002\r\n\r\n\r\n<b><size=33>\u8AAD\u307F\u8FBC\u307F</size></b>\r\n\r\ndrsakuu.humr
      Unity \u30D1\u30C3\u30B1\u30FC\u30B8\u3092 Unity 2022.3.22f1 \u306E\u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u306B\u30A4\u30F3\u30DD\u30FC\u30C8\u3057\u3001\u4EBA\u578B\u30A2\u30D0\u30BF\u30FC\u3092\u6301\u3064
      Animator \u306B HumrRecordingLoader \u30B3\u30F3\u30DD\u30FC\u30CD\u30F3\u30C8\u3092\u8FFD\u52A0\u3057\u307E\u3059\u3002\u9332\u753B\u3057\u305F
      Take \u3092\u542B\u3080 VRChat \u306E\u30ED\u30B0\u30D5\u30A1\u30A4\u30EB\u3092\u4E00\u89A7\u304B\u3089\u9078\u629E\u3057\u3001.fbx
      \u307E\u305F\u306F .anim \u3068\u3057\u3066\u30A8\u30AF\u30B9\u30DD\u30FC\u30C8\u3057\u307E\u3059\u3002\r\n\r\n\u8A73\u3057\u3044\u30AC\u30A4\u30C9\u3068\u30EA\u30EA\u30FC\u30B9\u60C5\u5831\r\n<b><size=33>\u9332\u753B</size></b>\r\n\r\n<color=#eae915><b>\u6CE8\u610F</b></color>:
      HUMR \u3067\u9332\u753B\u3059\u308B\u306B\u306F\u3001VRChat \u306E<color=#2aaac1>\u30C7\u30D0\u30C3\u30B0</color>\u8A2D\u5B9A\u3067<color=#2aaac1>\u30ED\u30B0\u306E\u51FA\u529B</color>\u3092<color=#2aaac1>\u5143\u5168</color>\u306B\u8A2D\u5B9A\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\r\n\r\n\u30DF\u30E9\u30FC\u306B\u3042\u308B\u30DC\u30BF\u30F3\u3092\u4F7F\u3063\u3066\u9332\u753B\u3092\u958B\u59CB\u30FB\u505C\u6B62\u3057\u307E\u3059\u3002\u540C\u3058\u30D5\u30A1\u30A4\u30EB\u306B\u8907\u6570\u56DE\u9332\u753B\u3059\u308B\u3068\u3001\u305D\u308C\u305E\u308C\u30C6\u30A4\u30AF\u3068\u3057\u3066\u5206\u5272\u3055\u308C\u307E\u3059\u3002\r\n\r\n\u9332\u753B\u6642\u3068\u30E2\u30FC\u30B7\u30E7\u30F3\u8AAD\u307F\u8FBC\u307F\u6642\u306B\u4F7F\u7528\u3059\u308B\u30A2\u30D0\u30BF\u30FC\u306E\u30DC\u30FC\u30F3\u306F\u3001\u5B8C\u5168\u306B\u4E00\u81F4\u3057\u3066\u3044\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\u73FE\u5728\u4F7F\u7528\u3057\u3066\u3044\u308B\u30A2\u30D0\u30BF\u30FC\u306E
      .fbx \u30D5\u30A1\u30A4\u30EB\u3092\u5165\u624B\u3067\u304D\u306A\u3044\u5834\u5408\u306F\u3001\u5DE6\u5074\u306E\u53F0\u5EA7\u306B\u3042\u308B
      HUMR\u3061\u3083\u3093\u3092\u4F7F\u7528\u3067\u304D\u307E\u3059\u3002HUMR\u3061\u3083\u3093\u306F\u30D1\u30C3\u30B1\u30FC\u30B8\u306B\u542B\u307E\u308C\u3066\u3044\u307E\u3059\u3002\u30A4\u30F3\u30DD\u30FC\u30C8\u5F8C\u3001Unity
